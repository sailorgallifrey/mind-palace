# Template for ~/.zsh_secrets
#
# Copy to ~/.zsh_secrets and fill in real values. The real file is NOT tracked
# in this repo and must never be committed.
#
#   cp dotfiles/mac-zsh/.zsh_secrets.example ~/.zsh_secrets
#   chmod 600 ~/.zsh_secrets
#
# This file holds credentials and internal-only endpoints. Keep it at mode 600.

# --- artifactory -----------------------------------------------------------
export ARTIFACTORY_USERNAME=""
export ARTIFACTORY_API_KEY=""

# --- grafana ---------------------------------------------------------------
export GRAFANA_URL=""
export GRAFANA_TOKEN=""

# --- datadog ---------------------------------------------------------------
export DD_API_KEY=""
export DD_APP_KEY=""

# --- go --------------------------------------------------------------------
# Comma-separated globs of module prefixes to fetch directly, bypassing the
# public proxy and checksum database (internal hosts).
export GOPRIVATE=""
